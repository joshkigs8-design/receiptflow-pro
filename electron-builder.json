{
  "appId": "ke.co.rentreceipt.desktop",
  "productName": "RentReceipt Pro",
  "directories": {
    "output": "release"
  },
  "files": [
    "electron/**/*",
    "public/**/*",
    ".output/**/*",
    "package.json"
  ],
  "win": {
    "target": "nsis",
    "icon": "public/favicon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "RentReceipt Pro"
  },
  "publish": {
    "provider": "github",
    "owner": "joshkigs8-design",
    "repo": "receiptflow-pro"
  }
}
